<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccountWeb</RootNamespace>
    <!-- Keep the frontend sources out of the web project build and publish output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);js/**;css/**;dist/**;node_modules/**;index.html;package.json;package-lock.json;vite.config.js;NuGet.config</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DarkFactor.Common.Lib" Version="1.6.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AccountClient\AccountClient.csproj" />
    <ProjectReference Include="..\AccountCommon\AccountCommon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Config/appsettings.Template.json" />
    <Content Update="Config/appsettings.*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
